<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>LetMeFight</RootNamespace>
    <AssemblyName>LetMeFight</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <BannerlordDir Condition="'$(BannerlordDir)' == '' and '$(BANNERLORD_DIR)' != ''">$(BANNERLORD_DIR)</BannerlordDir>
    <BannerlordDir Condition="'$(BannerlordDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordDir>
    <GameBinDir>$(BannerlordDir)\bin\Win64_Shipping_Client</GameBinDir>
    <ModuleRootDir>$(BannerlordDir)\Modules\LetMeFight</ModuleRootDir>
    <ModOutputDir>$(BannerlordDir)\Modules\LetMeFight\bin\Win64_Shipping_Client</ModOutputDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <OutputPath>$(ModOutputDir)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU'">
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(GameBinDir)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameBinDir)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameBinDir)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameBinDir)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameBinDir)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopySubModuleXmlToModule" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' and Exists('$(MSBuildThisFileDirectory)..\SubModule.xml')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\SubModule.xml" DestinationFiles="$(ModuleRootDir)\SubModule.xml" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PackageModuleZip" AfterTargets="CopySubModuleXmlToModule" Condition="'$(Configuration)' == 'Debug' and Exists('$(ModuleRootDir)\SubModule.xml')">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\SubModule.xml" Query="/Module/Version/@value">
      <Output TaskParameter="Result" PropertyName="ModuleVersion" />
    </XmlPeek>

    <PropertyGroup>
      <ModuleVersion Condition="'$(ModuleVersion)' == ''">dev</ModuleVersion>
      <ReleaseRootDir>$(MSBuildThisFileDirectory)..\releases</ReleaseRootDir>
      <ReleaseVersionDir>$(ReleaseRootDir)\$(ModuleVersion)</ReleaseVersionDir>
      <ReleaseZipFileName>LetMeFight $(ModuleVersion).zip</ReleaseZipFileName>
      <ReleaseZipPath>$(ReleaseRootDir)\$(ReleaseZipFileName)</ReleaseZipPath>
      <ReleaseVersionZipPath>$(ReleaseVersionDir)\$(ReleaseZipFileName)</ReleaseVersionZipPath>
    </PropertyGroup>

    <MakeDir Directories="$(ReleaseRootDir);$(ReleaseVersionDir)" />

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { Compress-Archive -Path '$(ModuleRootDir)' -DestinationPath '$(ReleaseZipPath)' -Force; Compress-Archive -Path '$(ModuleRootDir)' -DestinationPath '$(ReleaseVersionZipPath)' -Force }&quot;" />
  </Target>
</Project>
